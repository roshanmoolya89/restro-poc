{
    "openapi": "3.0.0",
    "info": {
        "title": "KitchenSpurs API",
        "description": "API documentation for KitchenSpurs restaurant management application",
        "version": "1.0.0",
        "contact": {
            "email": "support@kitchenspurs.com"
        }
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local Development Server"
        },
        {
            "url": "http://localhost",
            "description": "Docker Server"
        }
    ],
    "tags": [
        {
            "name": "General",
            "description": "General API endpoints"
        },
        {
            "name": "Locations",
            "description": "Location management endpoints"
        },
        {
            "name": "Restaurants",
            "description": "Restaurant management endpoints"
        },
        {
            "name": "Orders",
            "description": "Order management endpoints"
        }
    ],
    "components": {
        "schemas": {
            "SuccessResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Success"
                    },
                    "data": {
                        "type": "object"
                    }
                }
            },
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "Error message"
                    },
                    "data": {
                        "type": "object",
                        "nullable": true
                    }
                }
            },
            "InfoResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Welcome to the KitchenSpurs API"
                    }
                }
            },
            "Location": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Downtown"
                    },
                    "slug": {
                        "type": "string",
                        "example": "DT"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-01-29T10:30:00.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-01-29T10:30:00.000000Z"
                    }
                }
            },
            "LocationListResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Success"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Location"
                        }
                    }
                }
            },
            "LocationResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Success"
                    },
                    "data": {
                        "$ref": "#/components/schemas/Location"
                    }
                }
            },
            "Restaurant": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "The Gourmet Kitchen"
                    },
                    "address": {
                        "type": "string",
                        "example": "123 Main Street, City"
                    },
                    "phone": {
                        "type": "string",
                        "nullable": true,
                        "example": "+1-234-567-8900"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "nullable": true,
                        "example": "info@gourmetkitchen.com"
                    },
                    "location_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "cuisine_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-01-29T10:30:00.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-01-29T10:30:00.000000Z"
                    }
                }
            },
            "RestaurantListResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Success"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Restaurant"
                        }
                    }
                }
            },
            "RestaurantResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Success"
                    },
                    "data": {
                        "$ref": "#/components/schemas/Restaurant"
                    }
                }
            },
            "Order": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "restaurant_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "order_amount": {
                        "type": "number",
                        "format": "decimal",
                        "example": 45.99
                    },
                    "order_time": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-01-29T14:30:00.000000Z"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-01-29T10:30:00.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-01-29T10:30:00.000000Z"
                    }
                }
            },
            "OrderListResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Success"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Order"
                        }
                    }
                }
            },
            "OrderResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Success"
                    },
                    "data": {
                        "$ref": "#/components/schemas/Order"
                    }
                }
            },
            "OrderFiltersRequest": {
                "type": "object",
                "properties": {
                    "page": {
                        "type": "integer",
                        "example": 1,
                        "description": "Page number for pagination"
                    },
                    "status": {
                        "type": "string",
                        "example": "completed",
                        "description": "Filter by order status"
                    },
                    "restaurant_id": {
                        "type": "integer",
                        "example": 1,
                        "description": "Filter by restaurant ID"
                    },
                    "from_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-01-01",
                        "description": "Filter orders from this date"
                    },
                    "to_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-01-31",
                        "description": "Filter orders until this date"
                    }
                }
            },
            "RestaurantOrdersRequest": {
                "type": "object",
                "properties": {
                    "page": {
                        "type": "integer",
                        "example": 1,
                        "description": "Page number for pagination"
                    },
                    "status": {
                        "type": "string",
                        "example": "completed",
                        "description": "Filter by order status"
                    },
                    "from_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-01-01",
                        "description": "Filter orders from this date"
                    },
                    "to_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-01-31",
                        "description": "Filter orders until this date"
                    }
                }
            },
            "OrderTrendsResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Success"
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "total_orders": {
                                "type": "integer",
                                "example": 150
                            },
                            "total_revenue": {
                                "type": "number",
                                "format": "decimal",
                                "example": 6899.50
                            },
                            "average_order_value": {
                                "type": "number",
                                "format": "decimal",
                                "example": 45.99
                            },
                            "trends": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "date": {
                                            "type": "string",
                                            "format": "date",
                                            "example": "2026-01-15"
                                        },
                                        "order_count": {
                                            "type": "integer",
                                            "example": 12
                                        },
                                        "revenue": {
                                            "type": "number",
                                            "format": "decimal",
                                            "example": 551.88
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "paths": {
        "/api": {
            "get": {
                "summary": "Welcome endpoint",
                "description": "Returns a welcome message for the API",
                "tags": [
                    "General"
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/InfoResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/locations": {
            "get": {
                "summary": "Get all locations",
                "description": "Retrieve a paginated list of all locations",
                "tags": [
                    "Locations"
                ],
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1,
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LocationListResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/locations/{id}": {
            "get": {
                "summary": "Get location by ID",
                "description": "Retrieve a specific location by its ID",
                "tags": [
                    "Locations"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Location ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LocationResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Location not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/restaurants": {
            "get": {
                "summary": "Get all restaurants",
                "description": "Retrieve a paginated list of all restaurants",
                "tags": [
                    "Restaurants"
                ],
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1,
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RestaurantListResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/restaurants/{id}": {
            "get": {
                "summary": "Get restaurant by ID",
                "description": "Retrieve a specific restaurant by its ID",
                "tags": [
                    "Restaurants"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Restaurant ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RestaurantResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Restaurant not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/restaurants/{id}/trends": {
            "get": {
                "summary": "Get restaurant order trends",
                "description": "Retrieve order trends for a specific restaurant within a date range",
                "tags": [
                    "Restaurants"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Restaurant ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "description": "Start date (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-01-01"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "description": "End date (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-01-31"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderTrendsResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Restaurant not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/restaurants/{id}/orders": {
            "post": {
                "summary": "Get orders for a restaurant",
                "description": "Retrieve filtered orders for a specific restaurant",
                "tags": [
                    "Restaurants"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Restaurant ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "description": "Filter parameters for orders",
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RestaurantOrdersRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderListResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Restaurant not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/restaurants/{id}/orders/{order_id}": {
            "get": {
                "summary": "Get specific order for a restaurant",
                "description": "Retrieve a specific order by ID for a restaurant",
                "tags": [
                    "Restaurants"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Restaurant ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "order_id",
                        "in": "path",
                        "description": "Order ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Order or restaurant not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/orders": {
            "post": {
                "summary": "Get all orders",
                "description": "Retrieve filtered list of all orders across all restaurants",
                "tags": [
                    "Orders"
                ],
                "requestBody": {
                    "description": "Filter parameters for orders",
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OrderFiltersRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderListResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/orders/{id}": {
            "get": {
                "summary": "Get order by ID",
                "description": "Retrieve a specific order by its ID",
                "tags": [
                    "Orders"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Order ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Order not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}